# Copy to .env (never commit it) or set these in the Render dashboard.

# --- required in production ---
DJANGO_SECRET_KEY=change-me-to-a-long-random-string      # python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_ALLOWED_HOSTS=medgrid.onrender.com                 # comma-separated; Render's own hostname is added automatically
DATABASE_URL=postgres://user:pass@host:5432/dbname        # omit to use SQLite (db.sqlite3)

# --- local development only ---
# DJANGO_DEBUG=1

# --- medical document storage (production) ---
# Option A: S3-compatible private bucket (recommended)
# AWS_STORAGE_BUCKET_NAME=my-private-bucket
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
# AWS_S3_ENDPOINT_URL=https://<account>.r2.cloudflarestorage.com   # leave out for AWS S3
# AWS_S3_REGION_NAME=auto
# Option B: a Render persistent disk mounted at /var/data
# MEDIA_ROOT=/var/data/media

# --- optional ---
# SITE_BASE_URL=https://medgrid.onrender.com   # URL embedded in QR codes (defaults to the Render hostname)
# CSRF_TRUSTED_ORIGINS=https://medgrid.example.com
# CORS_ALLOWED_ORIGINS=https://app.example.com   # only if a separate front-end calls the API
# MAX_UPLOAD_MB=10
# QR_TOKEN_LIFETIME_DAYS=365                     # 0 = QR codes never expire
# SECURE_HSTS_SECONDS=31536000                   # raise from the 3600 default once HTTPS is confirmed working
# SESSION_COOKIE_AGE_SECONDS=43200
# SQLITE_PATH=/var/data/db.sqlite3               # if you stay on SQLite with a persistent disk
